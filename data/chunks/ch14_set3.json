        },
        {
          "id": "ch14_ex3_q3a",
          "number": "3(a)",
          "category": null,
          "questionText": "For the following value of $\\theta$, find $\\tan\\theta$: $\\theta = 180^\\circ$",
          "questionFigures": [],
          "solution": {
            "formula": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$",
            "steps": [
              "Given: $\\theta = 180^\\circ$. Goal: $\\tan\\theta$.",
              "$P(180^\\circ) = (-1, 0)$: $\\sin 180^\\circ = 0$, $\\cos 180^\\circ = -1$.",
              "$\\tan 180^\\circ = \\dfrac{0}{-1} = 0$."
            ],
            "finalAnswer": "$\\tan 180^\\circ = 0$",
            "solutionFigures": [],
            "tip": "Every multiple of $180^\\circ$ lies on the $x$-axis, so its tan is 0."
          }
        },
        {
          "id": "ch14_ex3_q3b",
          "number": "3(b)",
          "category": null,
          "questionText": "For the following value of $\\theta$, find $\\tan\\theta$: $\\theta = 360^\\circ$",
          "questionFigures": [],
          "solution": {
            "formula": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$",
            "steps": [
              "Given: $\\theta = 360^\\circ$. Goal: $\\tan\\theta$.",
              "$P(360^\\circ) = (1, 0)$: $\\sin 360^\\circ = 0$, $\\cos 360^\\circ = 1$.",
              "$\\tan 360^\\circ = \\dfrac{0}{1} = 0$."
            ],
            "finalAnswer": "$\\tan 360^\\circ = 0$",
            "solutionFigures": [],
            "tip": "A full turn brings you back to the start, so $\\tan 360^\\circ = \\tan 0^\\circ$."
          }
        },
        {
          "id": "ch14_ex3_q3c",
          "number": "3(c)",
          "category": null,
          "questionText": "For the following value of $\\theta$, find $\\tan\\theta$: $\\theta = 0$",
          "questionFigures": [],
          "solution": {
            "formula": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$",
            "steps": [
              "Given: $\\theta = 0$. Goal: $\\tan 0$.",
              "$P(0) = (1, 0)$: $\\sin 0 = 0$, $\\cos 0 = 1$.",
              "$\\tan 0 = \\dfrac{0}{1} = 0$."
            ],
            "finalAnswer": "$\\tan 0 = 0$",
            "solutionFigures": [],
            "tip": "The angle 0 is the same in degrees and radians."
          }
        },
        {
          "id": "ch14_ex3_q3d",
          "number": "3(d)",
          "category": null,
          "questionText": "For the following value of $\\theta$, find $\\tan\\theta$: $\\theta = -180^\\circ$",
          "questionFigures": [],
          "solution": {
            "formula": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$",
            "steps": [
              "Given: $\\theta = -180^\\circ$. Goal: $\\tan\\theta$.",
              "A half-turn clockwise reaches $(-1, 0)$: $\\sin(-180^\\circ) = 0$, $\\cos(-180^\\circ) = -1$.",
              "$\\tan(-180^\\circ) = \\dfrac{0}{-1} = 0$."
            ],
            "finalAnswer": "$\\tan(-180^\\circ) = 0$",
