        },
        {
          "id": "ch14_ex3_q3e",
          "number": "3(e)",
          "category": null,
          "questionText": "For the following value of $\\theta$, find $\\tan\\theta$: $\\theta = -540^\\circ$",
          "questionFigures": [],
          "solution": {
            "formula": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$; $P(\\theta + 360^\\circ) = P(\\theta)$",
            "steps": [
              "Given: $\\theta = -540^\\circ$. Goal: $\\tan\\theta$.",
              "Add $720^\\circ$: $-540^\\circ + 720^\\circ = 180^\\circ$, so $P(-540^\\circ) = P(180^\\circ) = (-1, 0)$.",
              "$\\tan(-540^\\circ) = \\dfrac{0}{-1} = 0$."
            ],
            "finalAnswer": "$\\tan(-540^\\circ) = 0$",
            "solutionFigures": [],
            "tip": "$-540^\\circ = -3 \\times 180^\\circ$, a multiple of $180^\\circ$, so tan is 0 immediately."
          }
        },
        {
          "id": "ch14_ex3_q3f",
          "number": "3(f)",
          "category": null,
          "questionText": "For the following value of $\\theta$, find $\\tan\\theta$: $\\theta = 720^\\circ$",
          "questionFigures": [],
          "solution": {
            "formula": "$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta}$; $P(\\theta + 360^\\circ) = P(\\theta)$",
            "steps": [
              "Given: $\\theta = 720^\\circ$. Goal: $\\tan\\theta$.",
              "$720^\\circ$ is two full turns, so $P(720^\\circ) = (1, 0)$.",
              "$\\tan 720^\\circ = \\dfrac{0}{1} = 0$."
            ],
            "finalAnswer": "$\\tan 720^\\circ = 0$",
            "solutionFigures": [],
            "tip": "Remove whole turns of $360^\\circ$ before evaluating."
          }
        }
