        {
          "id": "ch14_ex10_q1a",
          "number": "1(a)",
          "category": null,
          "questionText": "If $\\sin x = 0.3$, $\\cos\\alpha = 0.6$ and $\\tan\\theta = 0.7$, find the value of $\\cos(-\\alpha)$.",
          "questionFigures": [],
          "solution": {
            "formula": "Cosine is even: $\\cos(-\\alpha) = \\cos\\alpha$.",
            "steps": [
              "Given: $\\cos\\alpha = 0.6$. Goal: $\\cos(-\\alpha)$.",
              "$P(-\\alpha)$ is the reflection of $P(\\alpha)$ in the $x$-axis, so the $x$-coordinate is unchanged: $\\cos(-\\alpha) = \\cos\\alpha$.",
              "$\\cos(-\\alpha) = 0.6$."
            ],
            "finalAnswer": "$\\cos(-\\alpha) = 0.6$",
            "solutionFigures": [],
            "tip": "Cosine ignores the sign of the angle; sine and tangent change sign."
          }
        },
        {
          "id": "ch14_ex10_q1b",
          "number": "1(b)",
          "category": null,
          "questionText": "If $\\sin x = 0.3$, $\\cos\\alpha = 0.6$ and $\\tan\\theta = 0.7$, find the value of $\\sin\\left(\\frac{\\pi}{2} + \\alpha\\right)$.",
          "questionFigures": [],
          "solution": {
            "formula": "Complementary relationship $\\sin\\left(\\frac{\\pi}{2} + \\theta\\right) = \\cos\\theta$.",
            "steps": [
              "Given: $\\cos\\alpha = 0.6$. Goal: $\\sin\\left(\\frac{\\pi}{2} + \\alpha\\right)$.",
              "$\\sin\\left(\\frac{\\pi}{2} + \\alpha\\right) = \\cos\\alpha$.",
              "$= 0.6$."
            ],
            "finalAnswer": "$\\sin\\left(\\frac{\\pi}{2} + \\alpha\\right) = 0.6$",
            "solutionFigures": [],
            "tip": "Check with $\\alpha = 0$: $\\sin\\frac{\\pi}{2} = 1 = \\cos 0$."
          }
        },
        {
          "id": "ch14_ex10_q1c",
          "number": "1(c)",
          "category": null,
          "questionText": "If $\\sin x = 0.3$, $\\cos\\alpha = 0.6$ and $\\tan\\theta = 0.7$, find the value of $\\tan(-\\theta)$.",
          "questionFigures": [],
          "solution": {
            "formula": "Tangent is odd: $\\tan(-\\theta) = -\\tan\\theta$.",
            "steps": [
              "Given: $\\tan\\theta = 0.7$. Goal: $\\tan(-\\theta)$.",
              "$\\tan(-\\theta) = \\frac{\\sin(-\\theta)}{\\cos(-\\theta)} = \\frac{-\\sin\\theta}{\\cos\\theta} = -\\tan\\theta$.",
              "$\\tan(-\\theta) = -0.7$."
            ],
            "finalAnswer": "$\\tan(-\\theta) = -0.7$",
            "solutionFigures": [],
            "tip": "Build tangent results from the sine and cosine results."
          }
        },
        {
          "id": "ch14_ex10_q1d",
          "number": "1(d)",
          "category": null,
          "questionText": "If $\\sin x = 0.3$, $\\cos\\alpha = 0.6$ and $\\tan\\theta = 0.7$, find the value of $\\cos\\left(\\frac{\\pi}{2} - x\\right)$.",
          "questionFigures": [],
          "solution": {
            "formula": "Complementary relationship $\\cos\\left(\\frac{\\pi}{2} - \\theta\\right) = \\sin\\theta$.",
            "steps": [
              "Given: $\\sin x = 0.3$. Goal: $\\cos\\left(\\frac{\\pi}{2} - x\\right)$.",
              "$\\cos\\left(\\frac{\\pi}{2} - x\\right) = \\sin x$.",
              "$= 0.3$."
            ],
            "finalAnswer": "$\\cos\\left(\\frac{\\pi}{2} - x\\right) = 0.3$",
            "solutionFigures": [],
            "tip": "The cosine of an angle equals the sine of its complement."
          }
        },
        {
          "id": "ch14_ex10_q1e",
          "number": "1(e)",
          "category": null,
          "questionText": "If $\\sin x = 0.3$, $\\cos\\alpha = 0.6$ and $\\tan\\theta = 0.7$, find the value of $\\sin(-x)$.",
          "questionFigures": [],
          "solution": {
            "formula": "Sine is odd: $\\sin(-x) = -\\sin x$.",
            "steps": [
              "Given: $\\sin x = 0.3$. Goal: $\\sin(-x)$.",
              "$P(-x)$ is the reflection of $P(x)$ in the $x$-axis, so the $y$-coordinate changes sign.",
              "$\\sin(-x) = -0.3$."
            ],
            "finalAnswer": "$\\sin(-x) = -0.3$",
            "solutionFigures": [],
            "tip": "Picture the unit circle: reflecting in the $x$-axis flips the sign of the sine."
          }
        },
        {
          "id": "ch14_ex10_q1f",
          "number": "1(f)",
          "category": null,
          "questionText": "If $\\sin x = 0.3$, $\\cos\\alpha = 0.6$ and $\\tan\\theta = 0.7$, find the value of $\\tan\\left(\\frac{\\pi}{2} - \\theta\\right)$.",
          "questionFigures": [],
          "solution": {
            "formula": "$\\sin\\left(\\frac{\\pi}{2} - \\theta\\right) = \\cos\\theta$ and $\\cos\\left(\\frac{\\pi}{2} - \\theta\\right) = \\sin\\theta$, so $\\tan\\left(\\frac{\\pi}{2} - \\theta\\right) = \\frac{1}{\\tan\\theta}$.",
            "steps": [
              "Given: $\\tan\\theta = 0.7$. Goal: $\\tan\\left(\\frac{\\pi}{2} - \\theta\\right)$.",
              "$\\tan\\left(\\frac{\\pi}{2} - \\theta\\right) = \\frac{\\sin\\left(\\frac{\\pi}{2} - \\theta\\right)}{\\cos\\left(\\frac{\\pi}{2} - \\theta\\right)} = \\frac{\\cos\\theta}{\\sin\\theta} = \\frac{1}{\\tan\\theta}$.",
              "$= \\frac{1}{0.7} = \\frac{10}{7} \\approx 1.43$ (2 d.p.)."
            ],
            "finalAnswer": "$\\tan\\left(\\frac{\\pi}{2} - \\theta\\right) = \\frac{10}{7} \\approx 1.43$",
            "solutionFigures": [],
            "tip": "Tangent of the complement is the reciprocal, not the negative."
          }
        },
