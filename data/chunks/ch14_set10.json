        {
          "id": "ch14_ex10_q3",
          "number": "3",
          "category": null,
          "questionText": "Given that $\\cos x = \\frac{3}{5}$ and $\\frac{3\\pi}{2} < x < 2\\pi$, find $\\sin x$ and $\\tan x$.",
          "questionFigures": [],
          "solution": {
            "formula": "Pythagorean identity $\\cos^2 x + \\sin^2 x = 1$; $\\tan x = \\frac{\\sin x}{\\cos x}$.",
            "steps": [
              "Given: $\\cos x = \\frac{3}{5}$, $x$ in the 4th quadrant. Goal: $\\sin x$ and $\\tan x$.",
              "$\\sin^2 x = 1 - \\cos^2 x = 1 - \\frac{9}{25} = \\frac{16}{25}$, so $\\sin x = \\pm\\frac{4}{5}$.",
              "In the 4th quadrant sine is negative, so $\\sin x = -\\frac{4}{5}$.",
              "$\\tan x = \\frac{-4/5}{3/5} = -\\frac{4}{3}$.",
              "Check: $\\left(\\frac{3}{5}\\right)^2 + \\left(-\\frac{4}{5}\\right)^2 = \\frac{9 + 16}{25} = 1$."
            ],
            "finalAnswer": "$\\sin x = -\\frac{4}{5}$, $\\tan x = -\\frac{4}{3}$",
            "solutionFigures": [],
            "tip": "Use the quadrant to choose the sign after taking the square root."
          }
        },
        {
          "id": "ch14_ex10_q4",
          "number": "4",
          "category": null,
          "questionText": "Given that $\\sin x = \\frac{5}{13}$ and $\\frac{\\pi}{2} < x < \\pi$, find $\\cos x$ and $\\tan x$.",
          "questionFigures": [],
          "solution": {
            "formula": "Pythagorean identity $\\cos^2 x + \\sin^2 x = 1$; $\\tan x = \\frac{\\sin x}{\\cos x}$.",
            "steps": [
              "Given: $\\sin x = \\frac{5}{13}$, $x$ in the 2nd quadrant. Goal: $\\cos x$ and $\\tan x$.",
              "$\\cos^2 x = 1 - \\frac{25}{169} = \\frac{144}{169}$, so $\\cos x = \\pm\\frac{12}{13}$.",
              "In the 2nd quadrant cosine is negative, so $\\cos x = -\\frac{12}{13}$.",
              "$\\tan x = \\frac{5/13}{-12/13} = -\\frac{5}{12}$.",
              "Check: $\\frac{25 + 144}{169} = 1$."
            ],
            "finalAnswer": "$\\cos x = -\\frac{12}{13}$, $\\tan x = -\\frac{5}{12}$",
            "solutionFigures": [],
            "tip": "5, 12, 13 is a Pythagorean triple; spotting it saves working."
          }
        },
        {
          "id": "ch14_ex10_q5",
          "number": "5",
          "category": null,
          "questionText": "Given that $\\cos x = \\frac{1}{5}$ and $\\frac{3\\pi}{2} < x < 2\\pi$, find $\\sin x$ and $\\tan x$.",
          "questionFigures": [],
          "solution": {
            "formula": "Pythagorean identity $\\cos^2 x + \\sin^2 x = 1$; $\\tan x = \\frac{\\sin x}{\\cos x}$.",
            "steps": [
              "Given: $\\cos x = \\frac{1}{5}$, $x$ in the 4th quadrant. Goal: $\\sin x$ and $\\tan x$.",
              "$\\sin^2 x = 1 - \\frac{1}{25} = \\frac{24}{25}$, so $\\sin x = \\pm\\frac{\\sqrt{24}}{5} = \\pm\\frac{2\\sqrt{6}}{5}$.",
              "In the 4th quadrant sine is negative, so $\\sin x = -\\frac{2\\sqrt{6}}{5}$.",
              "$\\tan x = \\frac{-2\\sqrt{6}/5}{1/5} = -2\\sqrt{6}$.",
              "Check: $\\frac{1}{25} + \\frac{24}{25} = 1$."
            ],
            "finalAnswer": "$\\sin x = -\\frac{2\\sqrt{6}}{5}$, $\\tan x = -2\\sqrt{6}$",
            "solutionFigures": [],
            "tip": "Simplify surds: $\\sqrt{24} = 2\\sqrt{6}$."
          }
        }
