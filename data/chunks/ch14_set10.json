        {
          "id": "ch14_ex10_q2d",
          "number": "2(d)",
          "category": null,
          "questionText": "Given that $0 < \\theta < \\frac{\\pi}{2}$ and $\\sin\\theta = \\cos\\left(\\frac{3\\pi}{7}\\right)$, find the value of $\\theta$.",
          "questionFigures": [],
          "solution": {
