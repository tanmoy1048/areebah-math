      "exercises": [
        {
          "id": "ch14_ex5_q1a",
          "number": "1(a)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $120^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Quadrant 2 symmetry: $\\sin(180^\\circ - \\theta) = \\sin\\theta$, $\\cos(180^\\circ - \\theta) = -\\cos\\theta$, $\\tan(180^\\circ - \\theta) = -\\tan\\theta$; exact values for $60^\\circ$",
            "steps": [
              "Given: $120^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$120^\\circ = 180^\\circ - 60^\\circ$ (quadrant 2, basic angle $60^\\circ$).",
              "Exact values: $\\sin 60^\\circ = \\dfrac{\\sqrt{3}}{2}$, $\\cos 60^\\circ = \\dfrac{1}{2}$, $\\tan 60^\\circ = \\sqrt{3}$.",
              "$\\sin 120^\\circ = \\sin 60^\\circ = \\dfrac{\\sqrt{3}}{2}$.",
              "$\\cos 120^\\circ = -\\cos 60^\\circ = -\\dfrac{1}{2}$.",
              "$\\tan 120^\\circ = \\dfrac{\\sin 120^\\circ}{\\cos 120^\\circ} = \\dfrac{\\sqrt{3}/2}{-1/2} = -\\sqrt{3}$.",
              "Check: in quadrant 2 only sine is positive. ✓"
            ],
            "finalAnswer": "$\\sin 120^\\circ = \\dfrac{\\sqrt{3}}{2}$, $\\cos 120^\\circ = -\\dfrac{1}{2}$, $\\tan 120^\\circ = -\\sqrt{3}$",
            "solutionFigures": [],
            "tip": "Find the basic angle and the quadrant first; the quadrant fixes the signs."
          }
        },
        {
          "id": "ch14_ex5_q1b",
          "number": "1(b)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $135^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Quadrant 2 symmetry with basic angle $45^\\circ$: $\\sin 45^\\circ = \\cos 45^\\circ = \\dfrac{1}{\\sqrt{2}}$, $\\tan 45^\\circ = 1$",
            "steps": [
              "Given: $135^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$135^\\circ = 180^\\circ - 45^\\circ$ (quadrant 2, basic angle $45^\\circ$).",
              "$\\sin 135^\\circ = \\sin 45^\\circ = \\dfrac{1}{\\sqrt{2}}$.",
              "$\\cos 135^\\circ = -\\cos 45^\\circ = -\\dfrac{1}{\\sqrt{2}}$.",
              "$\\tan 135^\\circ = \\dfrac{1/\\sqrt{2}}{-1/\\sqrt{2}} = -1$.",
              "Check: $\\sin^2 + \\cos^2 = \\dfrac{1}{2} + \\dfrac{1}{2} = 1$. ✓"
            ],
            "finalAnswer": "$\\sin 135^\\circ = \\dfrac{1}{\\sqrt{2}}$, $\\cos 135^\\circ = -\\dfrac{1}{\\sqrt{2}}$, $\\tan 135^\\circ = -1$",
            "solutionFigures": [],
            "tip": "$\\frac{1}{\\sqrt{2}}$ and $\\frac{\\sqrt{2}}{2}$ are the same value; either form is exact."
          }
        },
        {
          "id": "ch14_ex5_q1c",
          "number": "1(c)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $210^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Quadrant 3 symmetry: $\\sin(180^\\circ + \\theta) = -\\sin\\theta$, $\\cos(180^\\circ + \\theta) = -\\cos\\theta$, $\\tan(180^\\circ + \\theta) = \\tan\\theta$",
            "steps": [
              "Given: $210^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$210^\\circ = 180^\\circ + 30^\\circ$ (quadrant 3, basic angle $30^\\circ$).",
              "Exact values: $\\sin 30^\\circ = \\dfrac{1}{2}$, $\\cos 30^\\circ = \\dfrac{\\sqrt{3}}{2}$, $\\tan 30^\\circ = \\dfrac{1}{\\sqrt{3}}$.",
              "$\\sin 210^\\circ = -\\dfrac{1}{2}$, $\\cos 210^\\circ = -\\dfrac{\\sqrt{3}}{2}$.",
              "$\\tan 210^\\circ = \\dfrac{-1/2}{-\\sqrt{3}/2} = \\dfrac{1}{\\sqrt{3}}$.",
              "Check: tan is positive in quadrant 3. ✓"
            ],
            "finalAnswer": "$\\sin 210^\\circ = -\\dfrac{1}{2}$, $\\cos 210^\\circ = -\\dfrac{\\sqrt{3}}{2}$, $\\tan 210^\\circ = \\dfrac{1}{\\sqrt{3}}$",
            "solutionFigures": [],
            "tip": "In quadrant 3 sine and cosine are both negative, so tan is positive."
          }
        },
        {
          "id": "ch14_ex5_q1d",
          "number": "1(d)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $240^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Quadrant 3 symmetry with basic angle $60^\\circ$",
            "steps": [
              "Given: $240^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$240^\\circ = 180^\\circ + 60^\\circ$ (quadrant 3, basic angle $60^\\circ$).",
              "$\\sin 240^\\circ = -\\sin 60^\\circ = -\\dfrac{\\sqrt{3}}{2}$.",
              "$\\cos 240^\\circ = -\\cos 60^\\circ = -\\dfrac{1}{2}$.",
              "$\\tan 240^\\circ = \\tan 60^\\circ = \\sqrt{3}$.",
              "Check: $\\dfrac{-\\sqrt{3}/2}{-1/2} = \\sqrt{3}$. ✓"
            ],
            "finalAnswer": "$\\sin 240^\\circ = -\\dfrac{\\sqrt{3}}{2}$, $\\cos 240^\\circ = -\\dfrac{1}{2}$, $\\tan 240^\\circ = \\sqrt{3}$",
            "solutionFigures": [],
            "tip": "For $60^\\circ$ the sine is the larger value $\\frac{\\sqrt{3}}{2}$; do not swap with $30^\\circ$."
          }
        },
        {
          "id": "ch14_ex5_q1e",
          "number": "1(e)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $315^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Quadrant 4 symmetry: $\\sin(360^\\circ - \\theta) = -\\sin\\theta$, $\\cos(360^\\circ - \\theta) = \\cos\\theta$, $\\tan(360^\\circ - \\theta) = -\\tan\\theta$",
            "steps": [
              "Given: $315^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$315^\\circ = 360^\\circ - 45^\\circ$ (quadrant 4, basic angle $45^\\circ$).",
              "$\\sin 315^\\circ = -\\sin 45^\\circ = -\\dfrac{1}{\\sqrt{2}}$.",
              "$\\cos 315^\\circ = \\cos 45^\\circ = \\dfrac{1}{\\sqrt{2}}$.",
              "$\\tan 315^\\circ = -\\tan 45^\\circ = -1$.",
              "Check: in quadrant 4 only cosine is positive. ✓"
            ],
            "finalAnswer": "$\\sin 315^\\circ = -\\dfrac{1}{\\sqrt{2}}$, $\\cos 315^\\circ = \\dfrac{1}{\\sqrt{2}}$, $\\tan 315^\\circ = -1$",
            "solutionFigures": [],
            "tip": "Remember 'All Stations To Central' for the positive function in quadrants 1 to 4."
          }
        },
        {
          "id": "ch14_ex5_q1f",
          "number": "1(f)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $390^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Periodicity: values repeat every $360^\\circ$",
            "steps": [
              "Given: $390^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$390^\\circ = 360^\\circ + 30^\\circ$, so $P(390^\\circ) = P(30^\\circ)$.",
              "$\\sin 390^\\circ = \\sin 30^\\circ = \\dfrac{1}{2}$.",
              "$\\cos 390^\\circ = \\cos 30^\\circ = \\dfrac{\\sqrt{3}}{2}$.",
              "$\\tan 390^\\circ = \\tan 30^\\circ = \\dfrac{1}{\\sqrt{3}}$."
            ],
            "finalAnswer": "$\\sin 390^\\circ = \\dfrac{1}{2}$, $\\cos 390^\\circ = \\dfrac{\\sqrt{3}}{2}$, $\\tan 390^\\circ = \\dfrac{1}{\\sqrt{3}}$",
            "solutionFigures": [],
            "tip": "Subtract $360^\\circ$ first, then use first-quadrant exact values."
          }
        },
        {
