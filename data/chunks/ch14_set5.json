        {
          "id": "ch14_ex5_q1h",
          "number": "1(h)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $-135^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "$P(-\\theta)$ is measured clockwise; $-135^\\circ + 360^\\circ = 225^\\circ = 180^\\circ + 45^\\circ$",
            "steps": [
              "Given: $-135^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$-135^\\circ$ is $135^\\circ$ clockwise, which lands in quadrant 3; equivalently $-135^\\circ + 360^\\circ = 225^\\circ = 180^\\circ + 45^\\circ$.",
              "$\\sin(-135^\\circ) = -\\sin 45^\\circ = -\\dfrac{1}{\\sqrt{2}}$.",
              "$\\cos(-135^\\circ) = -\\cos 45^\\circ = -\\dfrac{1}{\\sqrt{2}}$.",
              "$\\tan(-135^\\circ) = \\dfrac{-1/\\sqrt{2}}{-1/\\sqrt{2}} = 1$.",
              "Second route: $\\sin(-135^\\circ) = -\\sin 135^\\circ = -\\dfrac{1}{\\sqrt{2}}$, $\\cos(-135^\\circ) = \\cos 135^\\circ = -\\dfrac{1}{\\sqrt{2}}$. ✓"
            ],
            "finalAnswer": "$\\sin(-135^\\circ) = -\\dfrac{1}{\\sqrt{2}}$, $\\cos(-135^\\circ) = -\\dfrac{1}{\\sqrt{2}}$, $\\tan(-135^\\circ) = 1$",
            "solutionFigures": [],
            "tip": "Convert a negative angle to an equivalent positive one by adding $360^\\circ$."
          }
        },
        {
          "id": "ch14_ex5_q1i",
          "number": "1(i)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $-300^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "Periodicity: $-300^\\circ + 360^\\circ = 60^\\circ$",
            "steps": [
              "Given: $-300^\\circ$. Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$-300^\\circ + 360^\\circ = 60^\\circ$, so $P(-300^\\circ) = P(60^\\circ)$ (quadrant 1).",
              "$\\sin(-300^\\circ) = \\dfrac{\\sqrt{3}}{2}$, $\\cos(-300^\\circ) = \\dfrac{1}{2}$, $\\tan(-300^\\circ) = \\sqrt{3}$.",
              "Check: $300^\\circ$ clockwise is $60^\\circ$ short of a full clockwise turn, so it ends $60^\\circ$ above the positive $x$-axis. ✓"
            ],
            "finalAnswer": "$\\sin(-300^\\circ) = \\dfrac{\\sqrt{3}}{2}$, $\\cos(-300^\\circ) = \\dfrac{1}{2}$, $\\tan(-300^\\circ) = \\sqrt{3}$",
            "solutionFigures": [],
            "tip": "Negative angles are not automatically in quadrant 4; locate them carefully."
          }
        },
        {
          "id": "ch14_ex5_q1j",
          "number": "1(j)",
          "category": null,
          "questionText": "Without using a calculator, evaluate the sin, cos and tan of $-60^\\circ$.",
          "questionFigures": [],
          "solution": {
            "formula": "$\\sin(-\\theta) = -\\sin\\theta$, $\\cos(-\\theta) = \\cos\\theta$, $\\tan(-\\theta) = -\\tan\\theta$",
            "steps": [
              "Given: $-60^\\circ$ (quadrant 4). Goal: exact $\\sin$, $\\cos$, $\\tan$.",
              "$\\sin(-60^\\circ) = -\\sin 60^\\circ = -\\dfrac{\\sqrt{3}}{2}$.",
              "$\\cos(-60^\\circ) = \\cos 60^\\circ = \\dfrac{1}{2}$.",
              "$\\tan(-60^\\circ) = -\\tan 60^\\circ = -\\sqrt{3}$."
            ],
            "finalAnswer": "$\\sin(-60^\\circ) = -\\dfrac{\\sqrt{3}}{2}$, $\\cos(-60^\\circ) = \\dfrac{1}{2}$, $\\tan(-60^\\circ) = -\\sqrt{3}$",
            "solutionFigures": [],
            "tip": "Cosine is even; sine and tan are odd."
          }
        },
        {
