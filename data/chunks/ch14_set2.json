        {
          "id": "ch14_ex2_q1a",
          "number": "1(a)",
          "category": null,
          "questionText": "For the following angle $t$, determine the values of $\\sin t$ and $\\cos t$: $t = 0$",
          "questionFigures": [],
          "solution": {
            "formula": "Unit circle definition: $P(t) = (\\cos t, \\sin t)$",
            "steps": [
              "Given: $t = 0$. Goal: $\\sin 0$ and $\\cos 0$.",
              "A rotation of 0 leaves the point at the start, so $P(0) = (1, 0)$.",
              "The $x$-coordinate is the cosine and the $y$-coordinate is the sine.",
              "So $\\cos 0 = 1$ and $\\sin 0 = 0$."
            ],
            "finalAnswer": "$\\sin 0 = 0$, $\\cos 0 = 1$",
            "solutionFigures": [],
            "tip": "Remember the order: $P(t) = (\\cos t, \\sin t)$, with cosine first."
          }
        },
        {
          "id": "ch14_ex2_q1b",
          "number": "1(b)",
          "category": null,
          "questionText": "For the following angle $t$, determine the values of $\\sin t$ and $\\cos t$: $t = \\dfrac{3\\pi}{2}$",
          "questionFigures": [],
          "solution": {
            "formula": "Unit circle definition: $P(t) = (\\cos t, \\sin t)$",
            "steps": [
              "Given: $t = \\dfrac{3\\pi}{2}$. Goal: $\\sin t$ and $\\cos t$.",
              "$\\dfrac{3\\pi}{2}$ is three quarter-turns anticlockwise from $(1, 0)$, which lands on the negative $y$-axis.",
              "So $P\\left(\\dfrac{3\\pi}{2}\\right) = (0, -1)$.",
              "Therefore $\\cos\\dfrac{3\\pi}{2} = 0$ and $\\sin\\dfrac{3\\pi}{2} = -1$."
            ],
            "finalAnswer": "$\\sin\\dfrac{3\\pi}{2} = -1$, $\\cos\\dfrac{3\\pi}{2} = 0$",
            "solutionFigures": [],
            "tip": "Odd multiples of $\\frac{\\pi}{2}$ give points on the $y$-axis, so cosine is 0 and sine is $\\pm 1$."
          }
        },
        {
          "id": "ch14_ex2_q1c",
          "number": "1(c)",
          "category": null,
          "questionText": "For the following angle $t$, determine the values of $\\sin t$ and $\\cos t$: $t = -\\dfrac{3\\pi}{2}$",
          "questionFigures": [],
          "solution": {
            "formula": "Unit circle definition: $P(t) = (\\cos t, \\sin t)$; $P(t + 2\\pi) = P(t)$",
            "steps": [
              "Given: $t = -\\dfrac{3\\pi}{2}$. Goal: $\\sin t$ and $\\cos t$.",
              "Rotate three quarter-turns clockwise from $(1, 0)$: $(0, -1)$, then $(-1, 0)$, then $(0, 1)$.",
              "So $P\\left(-\\dfrac{3\\pi}{2}\\right) = (0, 1)$.",
              "Second route: $-\\dfrac{3\\pi}{2} + 2\\pi = \\dfrac{\\pi}{2}$, and $P\\left(\\dfrac{\\pi}{2}\\right) = (0, 1)$. ✓",
              "Therefore $\\cos\\left(-\\dfrac{3\\pi}{2}\\right) = 0$ and $\\sin\\left(-\\dfrac{3\\pi}{2}\\right) = 1$."
            ],
            "finalAnswer": "$\\sin\\left(-\\dfrac{3\\pi}{2}\\right) = 1$, $\\cos\\left(-\\dfrac{3\\pi}{2}\\right) = 0$",
            "solutionFigures": [],
            "tip": "Negative angles go clockwise; adding $2\\pi$ turns them into a familiar positive angle."
          }
        },
        {
          "id": "ch14_ex2_q1d",
          "number": "1(d)",
          "category": null,
          "questionText": "For the following angle $t$, determine the values of $\\sin t$ and $\\cos t$: $t = \\dfrac{5\\pi}{2}$",
          "questionFigures": [],
          "solution": {
            "formula": "Periodicity: $\\sin(2\\pi + \\theta) = \\sin\\theta$, $\\cos(2\\pi + \\theta) = \\cos\\theta$",
            "steps": [
              "Given: $t = \\dfrac{5\\pi}{2}$. Goal: $\\sin t$ and $\\cos t$.",
              "Write $\\dfrac{5\\pi}{2} = 2\\pi + \\dfrac{\\pi}{2}$.",
              "By periodicity, $P\\left(\\dfrac{5\\pi}{2}\\right) = P\\left(\\dfrac{\\pi}{2}\\right) = (0, 1)$.",
              "Therefore $\\cos\\dfrac{5\\pi}{2} = 0$ and $\\sin\\dfrac{5\\pi}{2} = 1$."
            ],
            "finalAnswer": "$\\sin\\dfrac{5\\pi}{2} = 1$, $\\cos\\dfrac{5\\pi}{2} = 0$",
            "solutionFigures": [],
            "tip": "Strip off whole multiples of $2\\pi$ first; they do not change the point."
          }
        },
        {
          "id": "ch14_ex2_q1e",
          "number": "1(e)",
          "category": null,
          "questionText": "For the following angle $t$, determine the values of $\\sin t$ and $\\cos t$: $t = -3\\pi$",
          "questionFigures": [],
          "solution": {
            "formula": "Periodicity: $\\sin(\\theta + 2k\\pi) = \\sin\\theta$, $\\cos(\\theta + 2k\\pi) = \\cos\\theta$",
            "steps": [
              "Given: $t = -3\\pi$. Goal: $\\sin t$ and $\\cos t$.",
              "Add $4\\pi$ (two full turns): $-3\\pi + 4\\pi = \\pi$.",
              "So $P(-3\\pi) = P(\\pi) = (-1, 0)$.",
              "Therefore $\\cos(-3\\pi) = -1$ and $\\sin(-3\\pi) = 0$."
            ],
            "finalAnswer": "$\\sin(-3\\pi) = 0$, $\\cos(-3\\pi) = -1$",
            "solutionFigures": [],
            "tip": "Any odd multiple of $\\pi$ lands on $(-1, 0)$."
          }
        },
        {
          "id": "ch14_ex2_q1f",
          "number": "1(f)",
          "category": null,
          "questionText": "For the following angle $t$, determine the values of $\\sin t$ and $\\cos t$: $t = \\dfrac{9\\pi}{2}$",
          "questionFigures": [],
          "solution": {
            "formula": "Periodicity: $\\sin(\\theta + 2k\\pi) = \\sin\\theta$, $\\cos(\\theta + 2k\\pi) = \\cos\\theta$",
            "steps": [
              "Given: $t = \\dfrac{9\\pi}{2}$. Goal: $\\sin t$ and $\\cos t$.",
              "Write $\\dfrac{9\\pi}{2} = 4\\pi + \\dfrac{\\pi}{2}$ (two full turns plus a quarter-turn).",
              "So $P\\left(\\dfrac{9\\pi}{2}\\right) = P\\left(\\dfrac{\\pi}{2}\\right) = (0, 1)$.",
              "Therefore $\\cos\\dfrac{9\\pi}{2} = 0$ and $\\sin\\dfrac{9\\pi}{2} = 1$."
            ],
            "finalAnswer": "$\\sin\\dfrac{9\\pi}{2} = 1$, $\\cos\\dfrac{9\\pi}{2} = 0$",
            "solutionFigures": [],
            "tip": "Write the angle as (multiple of $2\\pi$) + (angle in $[0, 2\\pi)$)."
          }
        },
        {
